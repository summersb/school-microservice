<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.school</groupId>
    <artifactId>micro-service-example</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>integration-tests</artifactId>
  <name>Integration Tests</name>
  <description>
    Black-box tests that exercise the full docker-compose stack through the
    Apache proxy at http://localhost:8080, verifying the six microservices
    genuinely work together (login, browse classes, enroll, view schedule,
    drop). NOT run as part of a normal `mvn test`/`mvn install` -- these
    require `docker compose up --build` to already be running. Run them
    explicitly with: mvn test -pl integration-tests -DskipITs=false
  </description>

  <properties>
    <!-- Skipped by default (see parent pom's skipITs=true) so a plain
         `mvn test` at the repo root never fails just because the compose
         stack isn't running. -->
    <base.url>http://localhost:8080</base.url>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-path</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <!-- rest-assured's Apache HttpClient needs commons-logging at runtime, but
         the imported Quarkus BOM re-scopes it away from the test classpath, so
         declare it explicitly here. -->
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.3.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipITs}</skipTests>
          <systemPropertyVariables>
            <base.url>${base.url}</base.url>
            <!-- The parent pom sets the JBoss LogManager for the Quarkus
                 modules. This module has no Quarkus dependency, so that class
                 isn't on the classpath and surefire prints a ClassNotFound
                 stack trace before every run: noise that looks like a real
                 failure in a CI log. Put the JDK default back. -->
            <java.util.logging.manager>java.util.logging.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
